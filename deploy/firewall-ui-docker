#!/usr/bin/env bash
set -Eeuo pipefail

DOCKER_DIR="${FIREWALL_UI_DOCKER_DIR:-/opt/firewall-ui-docker}"
DOCKER_MANAGER="${FIREWALL_UI_DOCKER_MANAGER:-/usr/local/bin/fw-ui-docker}"
DOCKER_PROJECT="${FIREWALL_UI_DOCKER_PROJECT:-firewall-ui}"
PUBLIC_MANAGER="${FIREWALL_UI_MANAGER:-/usr/local/bin/fw-ui}"
LEGACY_DOCKER_MANAGER="${FIREWALL_UI_LEGACY_DOCKER_MANAGER:-/usr/local/bin/firewall-ui-docker}"
DOCKER_INTERACTIVE=0

# Credentials are plain private files, never sourced as shell code or expanded
# through Compose dotenv interpolation. This also accepts passwords with $/'/\.
docker_read_setting() {
  local key="$1" fallback="$2" value
  value="$(sed -n "s/^${key}=//p" "$DOCKER_DIR/docker.env" 2>/dev/null | head -n 1)" || true
  printf '%s' "${value:-$fallback}"
}

docker_ask() {
  local name="$1" prompt="$2" fallback="$3" reply=''
  if [[ "$DOCKER_INTERACTIVE" == 1 ]]; then
    read -r -p "$prompt [$fallback]: " reply <&3 || return 1
  fi
  printf -v "$name" '%s' "${reply:-$fallback}"
}

docker_password() {
  local value="${FIREWALL_UI_PASSWORD:-}"
  if [[ "$DOCKER_INTERACTIVE" == 1 ]]; then
    read -r -s -p 'Пароль (любая непустая длина): ' value <&3 || return 1
    echo
  fi
  [[ -n "$value" && "$value" != *$'\r'* && "$value" != *$'\n'* ]] || { echo 'Укажите непустой пароль без перевода строки.' >&2; return 1; }
  DOCKER_PASSWORD="$value"
}

docker_compose_mode() {
  local mode="$1"; shift
  local source="$DOCKER_DIR/source" file=compose.yaml env_file="$DOCKER_DIR/docker.env"
  # Retain only stop/removal/rollback support for an already installed old layout.
  if [[ "$mode" != host && -f "$source/compose.$mode.yaml" ]]; then
    file="compose.$mode.yaml"
  elif [[ "$mode" != host && -f "$DOCKER_DIR/source.previous/compose.$mode.yaml" ]]; then
    source="$DOCKER_DIR/source.previous"; file="compose.$mode.yaml"
  fi
  if [[ "$mode" != host && -f "$DOCKER_DIR/docker.env.previous" ]]; then
    env_file="$DOCKER_DIR/docker.env.previous"
  fi
  local -a files=(-f "$source/$file")
  # Keep existing certificates readable while -save-config loads the previous
  # TLS configuration, including transitions back to local HTTP.
  if [[ -f "$source/compose.tls.yaml" && ( -n "$(docker_read_setting FIREWALL_UI_TLS_CERT '')" || -d "$DOCKER_DIR/access" ) ]]; then
    files+=(-f "$source/compose.tls.yaml")
  fi
  if [[ "$(docker_read_setting FIREWALL_UI_DOCKER_PORTS 0)" == 1 ]]; then
    files+=(-f "$source/compose.docker-ports.yaml")
  fi
  FIREWALL_UI_DOCKER_ACCESS_DIR="$DOCKER_DIR/access" \
  FIREWALL_UI_USERNAME="$(cat "$DOCKER_DIR/username")" \
  FIREWALL_UI_PASSWORD="$(cat "$DOCKER_DIR/password")" \
    docker compose --project-name "$DOCKER_PROJECT" --project-directory "$source" \
    --env-file "$env_file" "${files[@]}" "$@"
}

docker_compose() { docker_compose_mode "$(cat "$DOCKER_DIR/deployment")" "$@"; }

docker_install_plugin() (
  set -Eeuo pipefail
  local plugin="$1" version arch asset stage expected actual base
  case "$(uname -m)" in x86_64|amd64) arch=amd64;; aarch64|arm64) arch=arm64;; *) return 1;; esac
  [[ "$plugin" == compose ]] || return 1
  version=v5.6.0
  [[ "$arch" != amd64 ]] || arch=x86_64
  [[ "$arch" != arm64 ]] || arch=aarch64
  asset="docker-compose-linux-$arch"
  stage="$(mktemp -d)"; trap 'rm -rf -- "$stage"' EXIT
  base="https://github.com/docker/$plugin/releases/download/$version"
  curl -fLsS --retry 3 "$base/checksums.txt" -o "$stage/checksums"
  curl -fLsS --retry 3 "$base/$asset" -o "$stage/plugin"
  expected="$(awk -v name="$asset" '$NF == name || $NF == "*" name {print $1}' "$stage/checksums")"
  actual="$(sha256sum "$stage/plugin" | awk '{print $1}')"
  [[ "$expected" =~ ^[0-9A-Fa-f]{64}$ && "${expected,,}" == "$actual" ]] || { echo 'Контрольная сумма Docker-плагина не совпадает.' >&2; return 1; }
  install -d /usr/local/lib/docker/cli-plugins
  install -m 0755 "$stage/plugin" "/usr/local/lib/docker/cli-plugins/docker-$plugin"
)

docker_require_engine() {
  [[ "$(uname -s)" == Linux ]] || { echo 'Для управления файрволлом хоста нужен Linux.' >&2; return 1; }
  case "$(uname -m)" in x86_64|amd64|aarch64|arm64) ;; *) echo 'Поддерживаются amd64 и arm64.' >&2; return 1;; esac
  if ! command -v docker >/dev/null; then
    echo 'Docker не найден. Устанавливаем Docker Engine...'
    if command -v pacman >/dev/null; then pacman -S --needed --noconfirm docker docker-compose
    elif command -v apt-get >/dev/null; then apt-get update; DEBIAN_FRONTEND=noninteractive apt-get install -y docker.io curl ca-certificates
    elif command -v dnf >/dev/null; then dnf install -y moby-engine curl ca-certificates
    elif command -v zypper >/dev/null; then zypper --non-interactive install docker curl ca-certificates
    else echo 'Установите Docker Engine: https://docs.docker.com/engine/install/' >&2; return 1; fi
  fi
  if ! docker info >/dev/null 2>&1; then
    systemctl enable --now docker
    docker info >/dev/null || return 1
  fi
  [[ "$(docker info --format '{{json .SecurityOptions}}')" != *rootless* ]] || { echo 'Нужен обычный Docker Engine, не rootless: панель управляет файрволлом хоста.' >&2; return 1; }
  if ! command -v curl >/dev/null; then echo 'Установите curl и ca-certificates.' >&2; return 1; fi
  docker compose version >/dev/null 2>&1 || docker_install_plugin compose || return 1
}

docker_select_settings() (
  # Run the same wizard as native installation in an isolated shell.
  local installer="$DOCKER_DIR/source/install.sh" ports choice
  [[ -f "$installer" ]] || { echo 'Не найден общий мастер настройки.' >&2; return 1; }
  source "$installer"
  CONFIG_DIR="$DOCKER_DIR/access"; STATE_DIR="$DOCKER_DIR/access/state"
  INSTALL_INTERACTIVE="$DOCKER_INTERACTIVE"
  SAVED_PANEL_PORT="$(docker_read_setting FIREWALL_UI_DOCKER_PORT 8088)"
  SAVED_PUBLIC_HOST="$(docker_read_setting FIREWALL_UI_PUBLIC_HOST '')"
  SAVED_TLS_CERT="$(docker_read_setting FIREWALL_UI_TLS_CERT '')"
  SAVED_TLS_KEY="$(docker_read_setting FIREWALL_UI_TLS_KEY '')"
  # Read actual panel settings, which may have been changed through the web UI.
  if [[ -f "$DOCKER_DIR/deployment" && -f "$DOCKER_DIR/source/compose.yaml" ]]; then
    local config
    config="$(docker_compose run --rm --no-deps -T --entrypoint cat firewall-ui /etc/firewall-ui/config.json 2>/dev/null)" || config=''
    if [[ -n "$config" ]]; then
      SAVED_PANEL_PORT="$(printf '%s' "$config" | sed -n 's/.*"listenPort":[[:space:]]*\([0-9][0-9]*\).*/\1/p')"
      SAVED_PUBLIC_HOST="$(printf '%s' "$config" | sed -n 's/.*"publicHost":[[:space:]]*"\([^" ]*\)".*/\1/p')"
      SAVED_TLS_CERT="$(printf '%s' "$config" | sed -n 's/.*"tlsCert":[[:space:]]*"\([^" ]*\)".*/\1/p')"
      SAVED_TLS_KEY="$(printf '%s' "$config" | sed -n 's/.*"tlsKey":[[:space:]]*"\([^" ]*\)".*/\1/p')"
    fi
  fi
  [[ -z "${FIREWALL_UI_DOCKER_HOST:-}" ]] || FIREWALL_UI_LISTEN_HOST="$FIREWALL_UI_DOCKER_HOST"
  choose_access || return 1
  prepare_tls || return 1
  if [[ "$TLS_MODE" == existing && -n "$TLS_CERT" && "$TLS_CERT" != "$CONFIG_DIR/"* ]]; then
    local imported
    install -d -m 0700 "$CONFIG_DIR/tls"
    imported="$(mktemp -d "$CONFIG_DIR/tls/import-XXXXXX")"
    cp -L -- "$TLS_CERT" "$imported/fullchain.pem" || return 1
    cp -L -- "$TLS_KEY" "$imported/privkey.pem" || return 1
    chmod 0600 "$imported/privkey.pem"
    TLS_CERT="$imported/fullchain.pem"; TLS_KEY="$imported/privkey.pem"
    echo 'PEM-файлы скопированы в защищённый каталог Docker-панели.'
  fi
  ports="${FIREWALL_UI_DOCKER_PORTS:-$(docker_read_setting FIREWALL_UI_DOCKER_PORTS 0)}"
  choice=n; [[ "$ports" != 1 ]] || choice=y
  docker_ask choice 'Показывать опубликованные Docker-порты? Это подключит Docker socket (y/n)' "$choice"
  case "$choice" in y|Y) ports=1;; n|N) ports=0;; *) echo 'Введите y или n.' >&2; return 1;; esac
  printf 'host\n' > "$DOCKER_DIR/deployment"
  printf 'FIREWALL_UI_DOCKER_HOST=%s\nFIREWALL_UI_DOCKER_PORT=%s\nFIREWALL_UI_DOCKER_PORTS=%s\nFIREWALL_UI_PUBLIC_HOST=%s\nFIREWALL_UI_TLS_CERT=%s\nFIREWALL_UI_TLS_KEY=%s\nFIREWALL_UI_TLS_MODE=%s\nFIREWALL_UI_OPEN_PORTS=%s\n' \
    "$PANEL_HOST" "$((10#$PANEL_PORT))" "$ports" "$PUBLIC_HOST" "$TLS_CERT" "$TLS_KEY" "$TLS_MODE" "$OPEN_PORTS" > "$DOCKER_DIR/docker.env"
)

# Host-side ACME keeps the whole certificate tree mounted, including renewed links.
docker_setup_renewal() {
  local service=firewall-ui-docker-cert-renew
  if [[ "$(docker_read_setting FIREWALL_UI_TLS_MODE '')" != letsencrypt ]]; then
    systemctl disable --now "$service.timer" >/dev/null 2>&1 || true
    return 0
  fi
  local manager="${DOCKER_MANAGER//\%/%%}"
  manager="${manager//\\/\\\\}"; manager="${manager//\"/\\\"}"
  printf '[Unit]\nDescription=Renew Firewall-UI Docker certificate\nWants=network-online.target\nAfter=network-online.target\n\n[Service]\nType=oneshot\nExecStart=/usr/bin/env bash "%s" renew-certificates\nUMask=0077\n' "$manager" > /etc/systemd/system/$service.service
  printf '[Unit]\nDescription=Firewall-UI Docker certificate renewal\n\n[Timer]\nOnCalendar=*-*-* 00,12:00:00\nRandomizedDelaySec=1800\nPersistent=true\n\n[Install]\nWantedBy=timers.target\n' > /etc/systemd/system/$service.timer
  systemctl daemon-reload && systemctl enable --now "$service.timer"
}

docker_renew_certificates() {
  docker_existing_installation || return 1
  local hook
  printf -v hook '%q restart' "$DOCKER_MANAGER"
  certbot renew --quiet --config-dir "$DOCKER_DIR/access/acme" \
    --work-dir "$DOCKER_DIR/access/state/acme" --logs-dir "$DOCKER_DIR/access/state/acme-logs" --deploy-hook "$hook"
}

docker_cleanup_access() (
  [[ -f "$DOCKER_DIR/access/state/access-rules" || -f "$DOCKER_DIR/access/state/access-ufw" ]] || return 0
  local helper="$DOCKER_DIR/source/firewall-manager"
  [[ -f "$helper" ]] || { echo 'Для очистки правил доступа нужен сохранённый инструмент Firewall-UI.' >&2; return 1; }
  source "$helper"
  STATE_DIR="$DOCKER_DIR/access/state"
  cleanup_access_rules
)

docker_initial_credentials() {
  local user="${FIREWALL_UI_USERNAME:-admin}"
  docker_ask user 'Логин панели' "$user"
  [[ -n "$user" && "$user" != *$'\n'* && "$user" != *$'\r'* ]] || return 1
  docker_password || return 1
  printf '%s' "$user" > "$DOCKER_DIR/username"
  printf '%s' "$DOCKER_PASSWORD" > "$DOCKER_DIR/password"
  unset DOCKER_PASSWORD
}

docker_download_source() (
  set -Eeuo pipefail
  local stage file
  stage="$(mktemp -d "$DOCKER_DIR/.download-XXXXXX")"; trap 'rm -rf -- "$stage"' EXIT
  mkdir "$stage/source"
  for file in deploy/docker/compose.yaml deploy/docker/compose.docker-ports.yaml deploy/docker/compose.tls.yaml install.sh deploy/firewall-ui; do
    local target="${file##*/}"; [[ "$file" != deploy/firewall-ui ]] || target=firewall-manager
    if [[ -n "${FIREWALL_UI_DOCKER_SOURCE:-}" ]]; then cp "$FIREWALL_UI_DOCKER_SOURCE/$file" "$stage/source/$target" || return 1
    else curl -fLsS --retry 3 "https://raw.githubusercontent.com/SawaMEN/Firewall-UI/main/$file" -o "$stage/source/$target" || return 1; fi
  done
  rm -rf -- "$DOCKER_DIR/source.previous"
  if [[ -d "$DOCKER_DIR/source" ]]; then mv "$DOCKER_DIR/source" "$DOCKER_DIR/source.previous"; fi
  mv "$stage/source" "$DOCKER_DIR/source"
)

docker_download_image() (
  set -Eeuo pipefail
  local stage arch block url expected actual archive
  stage="$(mktemp -d)"; trap 'rm -rf -- "$stage"' EXIT
  if [[ -n "${FIREWALL_UI_DOCKER_IMAGE_ARCHIVE:-}" ]]; then
    archive="$FIREWALL_UI_DOCKER_IMAGE_ARCHIVE"; expected="${FIREWALL_UI_DOCKER_IMAGE_SHA256:-}"
  else
    case "$(uname -m)" in x86_64|amd64) arch=amd64;; aarch64|arm64) arch=arm64;; *) return 1;; esac
    curl -fLsS --retry 3 --connect-timeout 15 https://github.com/SawaMEN/Firewall-UI/releases/latest/download/docker-update.json -o "$stage/update.json" || return 1
    block="$(sed -n "/\"$arch\"[[:space:]]*:/,/^[[:space:]]*}/p" "$stage/update.json")"
    url="$(printf '%s\n' "$block" | sed -n 's/.*"url":[[:space:]]*"\([^" ]*\)".*/\1/p' | head -n 1)"
    expected="$(printf '%s\n' "$block" | sed -n 's/.*"sha256":[[:space:]]*"\([0-9A-Fa-f]*\)".*/\1/p' | head -n 1)"
    [[ "$url" =~ ^https://github.com/SawaMEN/Firewall-UI/releases/download/v[0-9.]+/firewall-ui-docker-linux-${arch}\.tar\.gz$ ]] || { echo 'Неверный адрес готового образа.' >&2; return 1; }
    archive="$stage/image.tar.gz"
    echo "Скачиваем готовый образ Linux/$arch из релиза GitHub..."
    curl -fLsS --retry 3 --connect-timeout 15 "$url" -o "$archive" || return 1
  fi
  [[ "$expected" =~ ^[0-9A-Fa-f]{64}$ ]] || { echo 'Нет контрольной суммы образа.' >&2; return 1; }
  actual="$(sha256sum "$archive" | awk '{print $1}')" || return 1
  [[ "${actual,,}" == "${expected,,}" ]] || { echo 'SHA-256 образа не совпадает.' >&2; return 1; }
  docker load -i "$archive" || return 1
  docker image inspect firewall-ui:stable >/dev/null || return 1
)

docker_write_volume_credentials() {
  # Reading stdin instead of arguments avoids exposing the password in ps/logs.
  printf '%s\n%s\n' "$(cat "$DOCKER_DIR/username")" "$(cat "$DOCKER_DIR/password")" |
    docker_compose run --rm --no-deps -T --entrypoint sh firewall-ui -c '
      set -eu; umask 077
      read -r user; read -r password
      escape() { printf "%s" "$1" | sed '\''s/\\/\\\\/g; s/"/\\"/g'\''; }
      mkdir -p /etc/firewall-ui
      stage=$(mktemp /etc/firewall-ui/.credentials-XXXXXX)
      trap '\''rm -f "$stage"'\'' EXIT
      printf "FIREWALL_UI_USERNAME=\"%s\"\nFIREWALL_UI_PASSWORD=\"%s\"\n" "$(escape "$user")" "$(escape "$password")" > "$stage"
      mv "$stage" /etc/firewall-ui/environment
    '
}

docker_apply_runtime_settings() {
  local bind cert secure=false
  bind="$(docker_read_setting FIREWALL_UI_DOCKER_HOST 127.0.0.1)"
  [[ "$bind" != *:* ]] || bind="[$bind]"
  cert="$(docker_read_setting FIREWALL_UI_TLS_CERT '')"
  [[ -z "$cert" ]] || secure=true
  docker_compose run --rm --no-deps -T firewall-ui -save-config \
    -listen "$bind:$(docker_read_setting FIREWALL_UI_DOCKER_PORT 8088)" \
    -public-host "$(docker_read_setting FIREWALL_UI_PUBLIC_HOST '')" -external-port 0 \
    -tls-cert "$cert" -tls-key "$(docker_read_setting FIREWALL_UI_TLS_KEY '')" -secure-cookies="$secure"
}

docker_runtime_backup() {
  local action="$1"
  docker_compose run --rm --no-deps -T --entrypoint sh firewall-ui -c '
    set -eu
    file=/etc/firewall-ui/config.json
    backup=/etc/firewall-ui/.installer-config.previous
    absent=/etc/firewall-ui/.installer-config.absent
    case "$1" in
      save)
        rm -f "$backup" "$absent"
        if [ -f "$file" ]; then cp -p "$file" "$backup"; else touch "$absent"; fi;;
      restore)
        if [ -f "$backup" ]; then mv "$backup" "$file"
        elif [ -f "$absent" ]; then rm -f "$file"; fi
        rm -f "$absent";;
      clear) rm -f "$backup" "$absent";;
    esac
  ' sh "$action"
}

docker_wait_for_service() {
  local cid attempt stable=0
  cid="$(docker_compose ps -q firewall-ui)"
  [[ -n "$cid" ]] || return 1
  for attempt in {1..15}; do
    if [[ "$(docker inspect --format '{{.State.Running}} {{.State.Restarting}}' "$cid")" == 'true false' ]]; then
      stable=$((stable+1)); ((stable < 3)) || return 0
    else stable=0; fi
    sleep 1
  done
  docker_compose logs --tail 30
  return 1
}

docker_show_access() {
  local host port scheme=http
  port="$(docker_read_setting FIREWALL_UI_DOCKER_PORT 8088)"
  host="$(docker_read_setting FIREWALL_UI_PUBLIC_HOST "$(docker_read_setting FIREWALL_UI_DOCKER_HOST 127.0.0.1)")"
  [[ "$host" != 0.0.0.0 && "$host" != :: ]] || host='<IP-сервера>'
  [[ "$host" != *:* ]] || host="[$host]"
  [[ -z "$(docker_read_setting FIREWALL_UI_TLS_CERT '')" ]] || scheme=https
  echo "Панель: $scheme://$host:$port/"
  echo "Управление: fw-ui; настройки сохранены в $DOCKER_DIR."
}

docker_require_exclusive() {
  if systemctl is-active --quiet firewall-ui.service 2>/dev/null; then
    echo 'Остановите обычную панель: systemctl stop firewall-ui. Одновременно используйте один вариант управления файрволлом.' >&2
    return 1
  fi
}

docker_install() (
  set -Eeuo pipefail
  local action="${1:-install}" first=0 old_mode='' stage succeeded=0 stopped=0 runtime_saved=0 old_image='' up_attempted=0 managers_replaced=0
  docker_require_engine || return 1
  docker_require_exclusive || return 1
  umask 077; mkdir -p "$DOCKER_DIR"; chmod 700 "$DOCKER_DIR"
  printf 'Firewall-UI Docker installer\n' > "$DOCKER_DIR/.installer-managed"
  [[ -f "$DOCKER_DIR/deployment" ]] || first=1
  stage="$(mktemp -d "$DOCKER_DIR/.settings-XXXXXX")"
  local file
  for file in deployment docker.env username password install.sh; do
    [[ ! -f "$DOCKER_DIR/$file" ]] || cp -p "$DOCKER_DIR/$file" "$stage/$file"
  done
  [[ ! -f "$DOCKER_MANAGER" ]] || cp -p "$DOCKER_MANAGER" "$stage/docker-manager"
  [[ ! -f "$PUBLIC_MANAGER" ]] || cp -p "$PUBLIC_MANAGER" "$stage/public-manager"
  [[ ! -f "$DOCKER_DIR/docker.env" ]] || cp -p "$DOCKER_DIR/docker.env" "$DOCKER_DIR/docker.env.previous"
  rollback() {
    local result=$?
    if (( !succeeded )); then
      # A failed `up` can leave a new container running. Stop it before
      # restoring the volume and restarting the previous deployment.
      if ((up_attempted)); then docker_compose stop || echo 'Не удалось остановить новую Docker-панель.' >&2; fi
      if ((runtime_saved)); then docker_runtime_backup restore || echo 'Не удалось восстановить конфигурацию в Docker-томе.' >&2; fi
      for file in deployment docker.env username password install.sh; do
        if [[ -f "$stage/$file" ]]; then cp -p "$stage/$file" "$DOCKER_DIR/$file"
        else rm -f -- "$DOCKER_DIR/$file"; fi
      done
      if [[ -d "$DOCKER_DIR/source.previous" ]]; then rm -rf -- "$DOCKER_DIR/source"; mv "$DOCKER_DIR/source.previous" "$DOCKER_DIR/source"; fi
      if ((managers_replaced)); then
        if [[ -f "$stage/docker-manager" ]]; then cp -p "$stage/docker-manager" "$DOCKER_MANAGER"; else rm -f -- "$DOCKER_MANAGER"; fi
        if [[ -f "$stage/public-manager" ]]; then cp -p "$stage/public-manager" "$PUBLIC_MANAGER"; else rm -f -- "$PUBLIC_MANAGER"; fi
      fi
      [[ -z "$old_image" ]] || docker tag "$old_image" firewall-ui:stable || true
      if ((stopped)) && [[ -n "$old_mode" ]]; then
        if docker_compose_mode "$old_mode" up -d --no-build; then
          docker_wait_for_service || echo 'Предыдущая Docker-панель не прошла проверку запуска.' >&2
        else echo 'Не удалось запустить предыдущую панель Docker Compose.' >&2; fi
      fi
      echo 'Установка Docker Compose не завершена. Настройки сохранены для повторной попытки.' >&2
    fi
    rm -f -- "$DOCKER_DIR/docker.env.previous"
    rm -rf -- "$stage"
    if ((first && !succeeded && !runtime_saved)); then
      if docker_cleanup_access; then rm -rf -- "$DOCKER_DIR"
      else echo 'Правила доступа не очищены; каталог сохранён для повторного удаления.' >&2; fi
    fi
    return "$result"
  }
  trap rollback EXIT
  [[ ! -f "$DOCKER_DIR/deployment" ]] || old_mode="$(cat "$DOCKER_DIR/deployment")"
  if ((first)); then docker_initial_credentials || return 1; fi
  # Refresh shared configuration code before presenting the wizard.
  docker_download_source || return 1
  if ((first)) || [[ "$action" == configure || "$old_mode" != host ]]; then docker_select_settings || return 1; fi
  docker_compose config --quiet || return 1
  old_image="$(docker image inspect firewall-ui:stable --format '{{.Id}}' 2>/dev/null || true)"
  docker_download_image || return 1
  if [[ -n "$old_mode" ]]; then
    stopped=1
    docker_compose_mode "$old_mode" stop || return 1
  fi
  if ((first)) || [[ "$action" == configure || "$old_mode" != host ]]; then
    docker_runtime_backup save || return 1
    runtime_saved=1
    docker_apply_runtime_settings || return 1
  fi
  if ((first)); then docker_write_volume_credentials || return 1; fi
  up_attempted=1
  docker_compose up -d --no-build || return 1
  docker_wait_for_service || return 1
  managers_replaced=1
  install -m 0755 "${BASH_SOURCE[0]}" "$DOCKER_MANAGER" || return 1
  install -m 0700 "$DOCKER_DIR/source/install.sh" "$DOCKER_DIR/install.sh" || return 1
  if ((first)) || [[ "$action" == configure ]]; then
    docker_setup_renewal || return 1
    (
      source "$DOCKER_DIR/source/install.sh"
      STATE_DIR="$DOCKER_DIR/access/state"
      OPEN_PORTS="$(docker_read_setting FIREWALL_UI_OPEN_PORTS 0)"
      allow_access_port "$(docker_read_setting FIREWALL_UI_DOCKER_PORT 8088)"
    ) || return 1
  fi
  install -m 0755 "$DOCKER_DIR/source/firewall-manager" "$PUBLIC_MANAGER" || return 1
  if ((runtime_saved)); then docker_runtime_backup clear || return 1; fi
  rm -rf -- "$DOCKER_DIR/source.previous"
  succeeded=1
  docker_remove_legacy_manager || return 1
  echo 'Версия Docker Compose Firewall-UI готова.'
  docker_show_access
)

docker_update_credentials() {
  local user="${1:-}"
  docker_require_exclusive || return 1
  docker_existing_installation || return 1
  docker_password || return 1
  # Keep the username saved by the web panel, including changes made after install.
  printf '%s\n%s\n' "$user" "$DOCKER_PASSWORD" | docker_compose run --rm --no-deps -T --entrypoint sh firewall-ui -c '
    set -eu; umask 077
    read -r user; read -r password
    escape() { printf "%s" "$1" | sed '\''s/\\/\\\\/g; s/"/\\"/g'\''; }
    mkdir -p /etc/firewall-ui
    userline=$(sed -n "/^FIREWALL_UI_USERNAME=/p" /etc/firewall-ui/environment 2>/dev/null || true)
    if [ -n "$user" ]; then userline="FIREWALL_UI_USERNAME=\"$(escape "$user")\""; fi
    if [ -z "$userline" ]; then userline="FIREWALL_UI_USERNAME=\"$(escape "$FIREWALL_UI_USERNAME")\""; fi
    stage=$(mktemp /etc/firewall-ui/.credentials-XXXXXX)
    trap '\''rm -f "$stage"'\'' EXIT
    printf "%s\nFIREWALL_UI_PASSWORD=\"%s\"\n" "$userline" "$(escape "$password")" > "$stage"
    mv "$stage" /etc/firewall-ui/environment
  ' || return 1
  printf '%s' "$DOCKER_PASSWORD" > "$DOCKER_DIR/password"
  [[ -z "$user" ]] || printf '%s' "$user" > "$DOCKER_DIR/username"
  unset DOCKER_PASSWORD
  docker_compose restart || return 1
  docker_wait_for_service || return 1
  echo 'Учётные данные Docker-панели обновлены.'
}

docker_reset_password() { docker_update_credentials ''; }

docker_change_credentials() {
  local user="${FIREWALL_UI_USERNAME:-}"
  docker_ask user 'Новый логин (Enter — сохранить текущий)' "$user" || return 1
  [[ "$user" != *$'\r'* && "$user" != *$'\n'* ]] || return 1
  docker_update_credentials "$user"
}

docker_existing_installation() {
  local file
  [[ -f "$DOCKER_DIR/.installer-managed" ]] || { echo 'Версия Docker Compose не установлена через этот установщик.' >&2; return 1; }
  for file in deployment docker.env username password; do
    [[ -s "$DOCKER_DIR/$file" ]] || { echo "Не найден файл Docker-настроек: $file" >&2; return 1; }
  done
  [[ -d "$DOCKER_DIR/source" ]] || return 1
  [[ "$(cat "$DOCKER_DIR/deployment")" =~ ^[a-z]+$ ]]
}

# Project labels alone may include unrelated services or volumes.
docker_owned_containers() {
  docker ps -aq --filter "label=com.docker.compose.project=$DOCKER_PROJECT" \
    --filter label=com.docker.compose.service=firewall-ui
}

docker_owned_volumes() {
  local volume role candidates
  candidates="$(docker volume ls -q --filter "label=com.docker.compose.project=$DOCKER_PROJECT")" || return 1
  for volume in $candidates; do
    role="$(docker volume inspect --format '{{index .Labels "com.docker.compose.volume"}}' "$volume")" || return 1
    case "$role" in firewall-ui-config|firewall-ui-data) printf '%s\n' "$volume";; esac
  done
}

docker_cleanup_image() {
  local version
  # 1.2.18 introduced complete owned-rule/ping cleanup without recreating state.
  # Probe without network, privileges, host paths or volumes.
  version="$(docker run --rm --pull never --network none --entrypoint /usr/local/bin/firewall-ui firewall-ui:stable -version 2>/dev/null)" || version=''
  if [[ "$version" =~ ^([0-9]+)\.([0-9]+)\.([0-9]+)$ ]]; then
    if ((10#${BASH_REMATCH[1]} > 1 || (10#${BASH_REMATCH[1]} == 1 &&
      (10#${BASH_REMATCH[2]} > 2 || (10#${BASH_REMATCH[2]} == 2 && 10#${BASH_REMATCH[3]} >= 18))))); then return 0; fi
  fi
  docker_download_image
}

docker_remove_legacy_manager() {
  if [[ "$LEGACY_DOCKER_MANAGER" != "$DOCKER_MANAGER" && -f "$LEGACY_DOCKER_MANAGER" ]] &&
     grep -Fq 'DOCKER_DIR=' "$LEGACY_DOCKER_MANAGER" &&
     grep -Fq 'SawaMEN/Firewall-UI' "$LEGACY_DOCKER_MANAGER"; then
    rm -f -- "$LEGACY_DOCKER_MANAGER" || return 1
  fi
}

docker_uninstall() (
  local renew=firewall-ui-docker-cert-renew
  if [[ -f /etc/systemd/system/$renew.timer || -f /etc/systemd/system/$renew.service ]]; then
    systemctl disable --now "$renew.timer" "$renew.service" >/dev/null 2>&1 || {
      systemctl is-active --quiet "$renew.timer" "$renew.service" && return 1
    }
    rm -f /etc/systemd/system/$renew.timer /etc/systemd/system/$renew.service || return 1
    systemctl daemon-reload || return 1
  fi
  local containers='' volumes='' volume role
  if command -v docker >/dev/null 2>&1; then
    docker info >/dev/null 2>&1 || { systemctl start docker || return 1; }
    containers="$(docker_owned_containers)" || return 1
    volumes="$(docker_owned_volumes)" || return 1
  fi
  if [[ -n "$containers$volumes" ]]; then
    # Resource labels allow recovery even when installer metadata was lost.
    local cid
    for cid in $containers; do
      docker stop --time 15 "$cid" >/dev/null || docker kill "$cid" >/dev/null || return 1
    done
    docker_cleanup_image || { echo 'Не удалось загрузить инструмент очистки; контейнеры остановлены, данные сохранены.' >&2; return 1; }
    local -a mounts=()
    for volume in $volumes; do
      role="$(docker volume inspect --format '{{index .Labels "com.docker.compose.volume"}}' "$volume")" || return 1
      case "$role" in
        firewall-ui-config) mounts+=(--mount "type=volume,src=$volume,dst=/etc/firewall-ui");;
        firewall-ui-data) mounts+=(--mount "type=volume,src=$volume,dst=/var/lib/firewall-ui");;
      esac
    done
    if ! docker run --rm --pull never --network host --pid host --privileged "${mounts[@]}" \
      --entrypoint /usr/local/bin/firewall-ui firewall-ui:stable -cleanup-firewall; then
      echo 'Не удалось очистить правила и запрет пинга. Данные сохранены.' >&2; return 1
    fi
    docker_cleanup_access || return 1
    for cid in $containers; do docker rm -f "$cid" >/dev/null || return 1; done
    for volume in $volumes; do docker volume rm "$volume" >/dev/null || return 1; done
    containers="$(docker_owned_containers)" || return 1
    volumes="$(docker_owned_volumes)" || return 1
    [[ -z "$containers$volumes" ]] || {
      echo 'Остались контейнеры или тома Firewall-UI. Данные установщика сохранены для повторной очистки.' >&2; return 1
    }
  fi
  if [[ -d "$DOCKER_DIR" && ! -f "$DOCKER_DIR/.installer-managed" && -n "$(find "$DOCKER_DIR" -mindepth 1 -maxdepth 1 -print -quit)" ]]; then
    echo "Каталог $DOCKER_DIR не отмечен как установка Firewall-UI; его содержимое сохранено." >&2; return 1
  fi
  docker_cleanup_access || return 1
  rm -rf -- "$DOCKER_DIR" || return 1
  rm -f -- "$DOCKER_MANAGER" || return 1
  docker_remove_legacy_manager || return 1
  if [[ ! -x "${FIREWALL_UI_NATIVE_BINARY:-/usr/local/firewall-ui/firewall-ui}" && -f "$PUBLIC_MANAGER" ]] &&
     grep -Fq 'REPO="SawaMEN/Firewall-UI"' "$PUBLIC_MANAGER"; then
    rm -f -- "$PUBLIC_MANAGER" || return 1
  fi
  if command -v docker >/dev/null 2>&1; then
    docker image rm firewall-ui:stable firewall-ui:local >/dev/null 2>&1 || true
  fi
  echo 'Версия Docker Compose полностью удалена: контейнеры, тома, настройки, данные, собственные правила и запрет пинга. Docker сохранён.'
)

docker_menu() (
  local installer="$DOCKER_DIR/install.sh" stage
  if [[ -f "$installer" ]]; then bash "$installer" --menu; return; fi
  stage="$(mktemp -d)"; trap 'rm -rf -- "$stage"' EXIT
  curl -fLsS --retry 3 --connect-timeout 15 https://raw.githubusercontent.com/SawaMEN/Firewall-UI/main/install.sh -o "$stage/install.sh"
  bash "$stage/install.sh" --menu
)

docker_main() {
  [[ ${EUID:-$(id -u)} -eq 0 ]] || { echo 'Запустите от root.' >&2; return 1; }
  [[ "$DOCKER_DIR" == /* && "$DOCKER_DIR" != / && "$DOCKER_DIR" != /opt && "$DOCKER_DIR" != /etc ]] || return 1
  if [[ "${FIREWALL_UI_NONINTERACTIVE:-0}" != 1 ]] && { exec 3<>/dev/tty; } 2>/dev/null; then DOCKER_INTERACTIVE=1; fi
  case "${1:-}" in
    install|update) docker_install install;; configure) docker_install configure;;
    credentials) docker_change_credentials;;
    renew-certificates) docker_renew_certificates;;
    reset-password) docker_reset_password;; uninstall) docker_uninstall;;
    start) docker_require_exclusive && docker_existing_installation && docker_compose up -d --no-build && docker_wait_for_service;;
    stop) docker_existing_installation && docker_compose stop;;
    restart) docker_require_exclusive && docker_existing_installation && docker_compose restart && docker_wait_for_service;;
    logs-once) docker_compose logs --tail 100;;
    status) docker_compose ps;; logs) docker_compose logs --tail 100 -f;;
    ''|menu) docker_menu;; *) echo 'Команды: install|update|configure|start|stop|restart|status|logs|credentials|reset-password|uninstall' >&2; return 1;;
  esac
}
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then docker_main "$@"; fi
