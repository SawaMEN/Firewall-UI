#!/usr/bin/env bash
set -euo pipefail

SERVICE="firewall-ui"
INSTALL_DIR="/usr/local/firewall-ui"
BIN="${INSTALL_DIR}/firewall-ui"
CONFIG="/etc/firewall-ui/config.json"
ENV_FILE="/etc/firewall-ui/environment"
REPO="SawaMEN/Firewall-UI"

require_root() {
  if [[ ${EUID:-$(id -u)} -ne 0 ]]; then
    echo "Run as root."
    exit 1
  fi
}

arch_name() {
  case "$(uname -m)" in
    x86_64|amd64) echo amd64 ;;
    aarch64|arm64) echo arm64 ;;
    *) echo "Unsupported architecture: $(uname -m)" >&2; return 1 ;;
  esac
}

update_channel() {
  if [[ -f "$CONFIG" ]]; then
    local channel
    channel="$(sed -n 's/.*"updateChannel":[[:space:]]*"\([^"]*\)".*/\1/p' "$CONFIG" | head -n 1)"
    if [[ "$channel" == "dev" ]]; then
      echo dev
      return
    fi
  fi
  echo stable
}

manifest_url() {
  local channel
  channel="$(update_channel)"
  if [[ "$channel" == "dev" ]]; then
    echo "https://github.com/${REPO}/releases/download/dev/update.json"
  else
    echo "https://github.com/${REPO}/releases/latest/download/update.json"
  fi
}

sha256_file() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  elif command -v openssl >/dev/null 2>&1; then
    openssl dgst -sha256 "$1" | awk '{print $NF}'
  else
    echo "sha256sum or openssl is required for verified updates" >&2
    return 1
  fi
}

service_action() {
  systemctl "$1" "${SERVICE}.service"
}

show_status() {
  systemctl --no-pager --full status "${SERVICE}.service" || true
  echo
  if [[ -f "$CONFIG" ]]; then
    echo "Configuration:"
    cat "$CONFIG"
  fi
}

show_logs() {
  journalctl -u "${SERVICE}.service" -n 100 -f
}

update_binary() {
  require_root
  command -v curl >/dev/null 2>&1 || { echo "curl is required"; exit 1; }
  local tmp manifest arch channel block url expected actual
  tmp="$(mktemp)"
  manifest="$(mktemp)"
  trap 'rm -f "$tmp" "$manifest"' RETURN
  arch="$(arch_name)"
  channel="$(update_channel)"
  if [[ "$channel" == "stable" ]]; then
    read -r -p "Install the latest stable Firewall-UI release? [y/N]: " answer
    if [[ ! "$answer" =~ ^[Yy]$ ]]; then
      return 0
    fi
  fi

  echo "Fetching signed-by-release checksum metadata ($channel)..."
  curl -fL --retry 3 --connect-timeout 15 "$(manifest_url)" -o "$manifest"
  block="$(sed -n "/\"$arch\"[[:space:]]*:/,/^[[:space:]]*}/p" "$manifest")"
  url="$(printf '%s\n' "$block" | sed -n 's/.*"url":[[:space:]]*"\([^"]*\)".*/\1/p' | head -n 1)"
  expected="$(printf '%s\n' "$block" | sed -n 's/.*"sha256":[[:space:]]*"\([0-9A-Fa-f]*\)".*/\1/p' | head -n 1)"
  if [[ ! "$url" =~ ^https://github.com/${REPO}/ ]] || [[ ! "$expected" =~ ^[0-9A-Fa-f]{64}$ ]]; then
    echo "Invalid update manifest." >&2
    return 1
  fi

  echo "Downloading latest Firewall-UI ($channel)..."
  curl -fL --retry 3 --connect-timeout 15 "$url" -o "$tmp"
  actual="$(sha256_file "$tmp")"
  if [[ "${actual,,}" != "${expected,,}" ]]; then
    echo "Update SHA-256 mismatch." >&2
    return 1
  fi

  cp -p "$BIN" "${BIN}.previous"
  install -m 0755 "$tmp" "$BIN"
  if ! systemctl restart "${SERVICE}.service"; then
    echo "Updated service failed to restart; restoring previous binary." >&2
    install -m 0755 "${BIN}.previous" "$BIN"
    systemctl restart "${SERVICE}.service" || true
    return 1
  fi
  rm -f "$tmp" "$manifest"
  trap - RETURN
  echo "Firewall-UI updated and SHA-256 verified."
}

rollback_binary() {
  require_root
  local previous="${BIN}.previous"
  if [[ ! -x "$previous" ]]; then
    echo "No previous Firewall-UI binary is available."
    return 1
  fi
  systemctl stop "${SERVICE}.service"
  local current="${BIN}.failed-$(date +%Y%m%d%H%M%S)"
  mv "$BIN" "$current"
  mv "$previous" "$BIN"
  chmod 0755 "$BIN"
  if systemctl start "${SERVICE}.service"; then
    echo "Firewall-UI rolled back to the previous binary."
    rm -f "$current"
  else
    mv "$BIN" "$previous"
    mv "$current" "$BIN"
    systemctl start "${SERVICE}.service" || true
    echo "Rollback failed; restored the current binary." >&2
    return 1
  fi
}

escape_env_value() {
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

change_credentials() {
  require_root
  local username password
  read -r -p "Username [admin]: " username
  username="${username:-admin}"
  while true; do
    read -r -s -p "Password (12+ characters): " password
    echo
    [[ ${#password} -ge 12 ]] && break
    echo "Password is too short."
  done
  install -d -m 0700 "$(dirname "$ENV_FILE")"
  {
    printf 'FIREWALL_UI_USERNAME="%s"\n' "$(escape_env_value "$username")"
    printf 'FIREWALL_UI_PASSWORD="%s"\n' "$(escape_env_value "$password")"
  } > "$ENV_FILE"
  chmod 0600 "$ENV_FILE"
  systemctl restart "${SERVICE}.service"
  echo "Credentials updated."
}

uninstall_service() {
  require_root
  systemctl disable --now "${SERVICE}.service" >/dev/null 2>&1 || true
  rm -f "/etc/systemd/system/${SERVICE}.service"
  rm -rf "$INSTALL_DIR"
  rm -f "/usr/local/bin/firewall-ui"
  systemctl daemon-reload
  read -r -p "Remove configuration and state too? [y/N]: " answer
  if [[ "$answer" =~ ^[Yy]$ ]]; then
    rm -rf /etc/firewall-ui /var/lib/firewall-ui
  fi
  echo "Firewall-UI uninstalled."
}

menu() {
  while true; do
    echo
    echo "Firewall-UI"
    echo "1) Status"
    echo "2) Start"
    echo "3) Stop"
    echo "4) Restart"
    echo "5) Logs"
    echo "6) Update"
    echo "7) Change username/password"
    echo "8) Roll back previous binary"
    echo "9) Uninstall"
    echo "0) Exit"
    read -r -p "Select: " choice
    case "$choice" in
      1) show_status ;;
      2) require_root; service_action start ;;
      3) require_root; service_action stop ;;
      4) require_root; service_action restart ;;
      5) show_logs ;;
      6) update_binary ;;
      7) change_credentials ;;
      8) rollback_binary ;;
      9) uninstall_service; exit 0 ;;
      0) exit 0 ;;
      *) echo "Unknown option." ;;
    esac
  done
}

case "${1:-}" in
  start|stop|restart|reload)
    require_root
    service_action "$1"
    ;;
  status)
    show_status
    ;;
  log|logs)
    show_logs
    ;;
  update)
    update_binary
    ;;
  credentials|password)
    change_credentials
    ;;
  rollback)
    rollback_binary
    ;;
  uninstall)
    uninstall_service
    ;;
  ""|menu)
    menu
    ;;
  *)
    echo "Usage: firewall-ui [start|stop|restart|status|logs|update|rollback|credentials|uninstall]"
    exit 2
    ;;
esac
