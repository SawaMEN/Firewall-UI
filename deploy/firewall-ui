#!/usr/bin/env bash
set -euo pipefail

SERVICE="firewall-ui"
INSTALL_DIR="/usr/local/firewall-ui"
BIN="${INSTALL_DIR}/firewall-ui"
CONFIG="/etc/firewall-ui/config.json"
ENV_FILE="/etc/firewall-ui/environment"
REPO="SawaMEN/Firewall-UI"
CONFIG_DIR="/etc/firewall-ui"
STATE_DIR="/var/lib/firewall-ui"
UNIT_DIR="/etc/systemd/system"
MANAGER_PATH="/usr/local/bin/firewall-ui"

require_root() {
  if [[ ${EUID:-$(id -u)} -ne 0 ]]; then
    echo "Run as root."
    exit 1
  fi
}

arch_name() {
  case "$(uname -m)" in
    x86_64|amd64) echo amd64 ;;
    aarch64|arm64) echo arm64 ;;
    *) echo "Unsupported architecture: $(uname -m)" >&2; return 1 ;;
  esac
}

update_channel() {
  if [[ -f "$CONFIG" ]]; then
    local channel
    channel="$(sed -n 's/.*"updateChannel":[[:space:]]*"\([^"]*\)".*/\1/p' "$CONFIG" | head -n 1)"
    if [[ "$channel" == "dev" ]]; then
      echo dev
      return
    fi
  fi
  echo stable
}

manifest_url() {
  local channel
  channel="$(update_channel)"
  if [[ "$channel" == "dev" ]]; then
    echo "https://github.com/${REPO}/releases/download/dev/update.json"
  else
    echo "https://github.com/${REPO}/releases/latest/download/update.json"
  fi
}

sha256_file() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  elif command -v openssl >/dev/null 2>&1; then
    openssl dgst -sha256 "$1" | awk '{print $NF}'
  else
    echo "sha256sum or openssl is required for verified updates" >&2
    return 1
  fi
}

service_action() {
  systemctl "$1" "${SERVICE}.service"
}

show_status() {
  systemctl --no-pager --full status "${SERVICE}.service" || true
  echo
  if [[ -f "$CONFIG" ]]; then
    echo "Configuration:"
    cat "$CONFIG"
  fi
}

show_logs() {
  journalctl -u "${SERVICE}.service" -n 100 -f
}

wait_for_service() {
  local attempt stable=0
  for attempt in {1..20}; do
    if systemctl is-active --quiet "${SERVICE}.service"; then
      stable=$((stable+1))
      if ((stable >= 3)); then return 0; fi
    else
      stable=0
    fi
    sleep 1
  done
  return 1
}

# Run in a subshell so failure cleanup also works under set -e and cannot
# leave RETURN traps referring to expired local variables.
replace_binary() (
  set -Eeuo pipefail
  local candidate="$1" stage replaced=0 succeeded=0 was_active=0
  [[ -x "$BIN" ]] || { echo "Installed binary not found: $BIN" >&2; exit 1; }
  "$candidate" -config "$CONFIG" -check-config
  stage="$(mktemp -d "${INSTALL_DIR}/.replace-XXXXXX")"
  cleanup_replace() {
    local result=$?
    trap - EXIT
    if ((replaced && !succeeded)); then
      echo 'Service failed after replacement; restoring the current binary.' >&2
      systemctl stop "${SERVICE}.service" || true
      # Rename a staged copy rather than writing into a running executable.
      if mv -f "$stage/current" "$BIN"; then
        if ((was_active)); then
          systemctl restart "${SERVICE}.service" || true
        fi
      else
        echo "Could not restore the binary; recovery copy: $stage/current" >&2
        return "$result"
      fi
    fi
    rm -rf -- "$stage"
    return "$result"
  }
  trap cleanup_replace EXIT
  cp -p "$BIN" "$stage/current"
  install -m 0755 "$candidate" "$stage/candidate"
  systemctl is-active --quiet "${SERVICE}.service" && was_active=1
  mv -f "$stage/candidate" "$BIN"
  replaced=1
  systemctl restart "${SERVICE}.service"
  wait_for_service
  # Do not overwrite the known previous version unless the new one starts.
  mv -f "$stage/current" "${BIN}.previous"
  succeeded=1
)

update_binary() (
  set -Eeuo pipefail
  require_root
  command -v curl >/dev/null 2>&1 || { echo 'curl is required' >&2; exit 1; }
  local stage manifest arch channel block url expected actual answer
  arch="$(arch_name)"
  channel="$(update_channel)"
  if [[ "$channel" == stable && "${FIREWALL_UI_NONINTERACTIVE:-0}" != 1 ]]; then
    read -r -p 'Install the latest stable Firewall-UI release? [y/N]: ' answer
    [[ "$answer" =~ ^[Yy]$ ]] || exit 0
  fi
  stage="$(mktemp -d)"
  trap 'rm -rf -- "$stage"' EXIT
  manifest="$stage/update.json"
  echo "Fetching release checksum metadata ($channel)..."
  curl -fL --retry 3 --connect-timeout 15 "$(manifest_url)" -o "$manifest"
  block="$(sed -n "/\"$arch\"[[:space:]]*:/,/^[[:space:]]*}/p" "$manifest")"
  url="$(printf '%s\n' "$block" | sed -n 's/.*"url":[[:space:]]*"\([^" ]*\)".*/\1/p' | head -n 1)"
  expected="$(printf '%s\n' "$block" | sed -n 's/.*"sha256":[[:space:]]*"\([0-9A-Fa-f]*\)".*/\1/p' | head -n 1)"
  [[ "$url" =~ ^https://github.com/${REPO}/releases/download/[A-Za-z0-9._-]+/firewall-ui-linux-${arch}$ && "$expected" =~ ^[0-9A-Fa-f]{64}$ ]] || { echo 'Invalid update manifest.' >&2; exit 1; }
  curl -fL --retry 3 --connect-timeout 15 "$url" -o "$stage/binary"
  actual="$(sha256_file "$stage/binary")"
  [[ "${actual,,}" == "${expected,,}" ]] || { echo 'Update SHA-256 mismatch.' >&2; exit 1; }
  chmod 0755 "$stage/binary"
  replace_binary "$stage/binary"
  echo 'Firewall-UI updated, SHA-256 verified and service running.'
)

rollback_binary() {
  require_root
  local previous="${BIN}.previous"
  [[ -x "$previous" ]] || { echo 'No previous Firewall-UI binary is available.' >&2; return 1; }
  replace_binary "$previous"
  echo 'Firewall-UI rolled back. The replaced version is retained as .previous.'
}

escape_env_value() {
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

change_credentials() (
  set -Eeuo pipefail
  require_root
  local username="${FIREWALL_UI_USERNAME:-}" password userline stage
  userline="$(sed -n '/^FIREWALL_UI_USERNAME=/p' "$ENV_FILE" 2>/dev/null | head -n 1)" || true
  if [[ "${FIREWALL_UI_NONINTERACTIVE:-0}" != 1 ]]; then
    read -r -p 'Новый логин (Enter — сохранить текущий): ' username
    echo 'Рекомендация: используйте длинный уникальный пароль.'
    read -r -s -p 'Новый пароль (Enter — сгенерировать): ' password
    echo
  else
    [[ -v FIREWALL_UI_PASSWORD ]] || { echo 'Задайте FIREWALL_UI_PASSWORD.' >&2; return 1; }
    password="$FIREWALL_UI_PASSWORD"
  fi
  if [[ -z "$password" ]]; then
    password="$(od -An -N20 -tx1 /dev/urandom | tr -d ' \n')"
    printf 'Сгенерированный пароль: %s\n' "$password"
  fi
  [[ "$username$password" != *$'\r'* && "$username$password" != *$'\n'* ]] || return 1
  if [[ -n "$username" || -z "$userline" ]]; then
    userline="FIREWALL_UI_USERNAME=\"$(escape_env_value "${username:-admin}")\""
  fi
  install -d -m 0700 "$(dirname "$ENV_FILE")"
  stage="$(mktemp "$(dirname "$ENV_FILE")/.credentials-XXXXXX")"
  trap 'rm -f -- "$stage"' EXIT
  if [[ -f "$ENV_FILE" ]]; then sed '/^FIREWALL_UI_USERNAME=/d; /^FIREWALL_UI_PASSWORD=/d' "$ENV_FILE" > "$stage"; fi
  printf '%s\nFIREWALL_UI_PASSWORD="%s"\n' "$userline" "$(escape_env_value "$password")" >> "$stage"
  chmod 0600 "$stage"
  mv -f -- "$stage" "$ENV_FILE"
  systemctl restart "${SERVICE}.service"
  echo 'Учётные данные обновлены.'
)

reset_password() (
  set -euo pipefail
  require_root
  [[ -x "$BIN" && -f "$ENV_FILE" ]] || { echo 'Firewall-UI не установлен или нет файла учётных данных.' >&2; return 1; }
  local password stage
  if [[ -v FIREWALL_UI_PASSWORD ]]; then password="$FIREWALL_UI_PASSWORD"
  elif [[ "${FIREWALL_UI_NONINTERACTIVE:-0}" == 1 ]]; then
    echo 'Для сброса без вопросов задайте FIREWALL_UI_PASSWORD.' >&2; return 1
  else
    echo 'Рекомендация: используйте длинный уникальный пароль.'
    read -r -s -p 'Новый пароль (любой длины; Enter — сгенерировать): ' password
    echo
  fi
  if [[ -z "$password" ]]; then
    password="$(od -An -N20 -tx1 /dev/urandom | tr -d ' \n')"
    echo "Сгенерированный пароль: $password"
  fi
  [[ "$password" != *$'\r'* && "$password" != *$'\n'* ]] || { echo 'Перевод строки в пароле не поддерживается.' >&2; return 1; }
  stage="$(mktemp "$(dirname "$ENV_FILE")/.password-XXXXXX")"
  trap 'rm -f -- "$stage"' EXIT
  # Preserve the username and all other environment settings verbatim.
  sed '/^FIREWALL_UI_PASSWORD=/d' "$ENV_FILE" > "$stage"
  printf 'FIREWALL_UI_PASSWORD="%s"\n' "$(escape_env_value "$password")" >> "$stage"
  chmod 0600 "$stage"
  mv -f -- "$stage" "$ENV_FILE"
  if ! systemctl restart "${SERVICE}.service"; then
    echo 'Новый пароль сохранён, но служба не перезапустилась. Выполните firewall-ui restart.' >&2
    return 1
  fi
  echo 'Пароль сброшен. Логин сохранён. Войдите с новым паролем.'
)

cleanup_access_rules() {
  [[ -f "$STATE_DIR/access-rules" ]] || return 0
  local layer zone port
  while read -r layer zone port; do
    [[ "$layer" == runtime || "$layer" == permanent ]] || { echo 'Некорректный журнал правил доступа.' >&2; return 1; }
    [[ "$zone" =~ ^[A-Za-z0-9_-]+$ && "$port" =~ ^[0-9]+/tcp$ ]] || return 1
    if [[ "$layer" == permanent ]]; then
      if firewall-cmd --state >/dev/null 2>&1; then
        if firewall-cmd --permanent --zone="$zone" --query-port="$port" >/dev/null 2>&1; then
          firewall-cmd --permanent --zone="$zone" --remove-port="$port" || return 1
        fi
      else
        command -v firewall-offline-cmd >/dev/null || return 1
        if firewall-offline-cmd --zone="$zone" --query-port="$port" >/dev/null 2>&1; then
          firewall-offline-cmd --zone="$zone" --remove-port="$port" || return 1
        fi
      fi
    elif firewall-cmd --state >/dev/null 2>&1 && firewall-cmd --zone="$zone" --query-port="$port" >/dev/null 2>&1; then
      firewall-cmd --zone="$zone" --remove-port="$port" || return 1
    fi
  done < "$STATE_DIR/access-rules"
  rm -f -- "$STATE_DIR/access-rules"
}

wait_uninstall_unit() {
  local unit="$1" state attempt
  for ((attempt=0; attempt<10; attempt++)); do
    state="$(systemctl show "$unit" --property=ActiveState --value 2>/dev/null)" || true
    if [[ "$(systemctl show "$unit" --property=LoadState --value 2>/dev/null || true)" == not-found ]]; then return 0; fi
    case "$state" in inactive|failed) return 0;; esac
    sleep 0.5
  done
  return 1
}

stop_uninstall_unit() {
  local unit="$1" stop_error
  # Separate jobs: a missing renewal unit must not interfere with the panel.
  # Disable the timer before stopping it so it cannot launch another renewal.
  systemctl disable "$unit" >/dev/null 2>&1 || true
  stop_error="$(systemctl stop --no-block "$unit" 2>&1)" || true
  if wait_uninstall_unit "$unit"; then return 0; fi
  # A stuck shutdown must not hold the installer for systemd's default timeout.
  # Signal only processes belonging to this unit, never unrelated listeners.
  systemctl kill --kill-whom=all --signal=SIGTERM "$unit" >/dev/null 2>&1 || true
  if wait_uninstall_unit "$unit"; then return 0; fi
  systemctl kill --kill-whom=all --signal=SIGKILL "$unit" >/dev/null 2>&1 || true
  if wait_uninstall_unit "$unit"; then return 0; fi
  echo "Не удалось завершить $unit. Файлы сохранены." >&2
  [[ -z "$stop_error" ]] || printf '%s\n' "$stop_error" >&2
  systemctl status --no-pager "$unit" >&2 || true
  return 1
}

cleanup_ping_rules() {
  # Also repair ping policy left by older binaries without the new cleanup.
  [[ -f "$STATE_DIR/state.json" ]] || return 0
  if ! grep -Eq '"firewallPingEnabled"[[:space:]]*:[[:space:]]*"false"' "$STATE_DIR/state.json"; then return 0; fi
  local path root="${FIREWALL_UI_SYSCTL_DIR:-/proc/sys}"
  for path in "$root/net/ipv4/icmp_echo_ignore_all" "$root/net/ipv6/icmp/echo_ignore_all"; do
    [[ -e "$path" ]] || continue
    printf '0\n' > "$path" || { echo "Не удалось снять запрет пинга: $path" >&2; return 1; }
  done
}

cleanup_missing_binary() (
  local stage arch block url expected actual
  stage="$(mktemp -d)"; trap 'rm -rf -- "$stage"' EXIT
  arch="$(arch_name)" || return 1
  curl -fLsS --retry 3 --connect-timeout 15 "https://github.com/$REPO/releases/latest/download/update.json" -o "$stage/update.json" || return 1
  block="$(sed -n "/\"$arch\"[[:space:]]*:/,/^[[:space:]]*}/p" "$stage/update.json")"
  url="$(printf '%s\n' "$block" | sed -n 's/.*"url":[[:space:]]*"\([^" ]*\)".*/\1/p' | head -n 1)"
  expected="$(printf '%s\n' "$block" | sed -n 's/.*"sha256":[[:space:]]*"\([0-9A-Fa-f]*\)".*/\1/p' | head -n 1)"
  [[ "$url" =~ ^https://github.com/${REPO}/releases/download/[A-Za-z0-9._-]+/firewall-ui-linux-${arch}$ && "$expected" =~ ^[0-9A-Fa-f]{64}$ ]] || return 1
  curl -fLsS --retry 3 --connect-timeout 15 "$url" -o "$stage/binary" || return 1
  actual="$(sha256_file "$stage/binary")"
  [[ "${actual,,}" == "${expected,,}" ]] || return 1
  chmod 0755 "$stage/binary" || return 1
  "$stage/binary" -config "$CONFIG" -cleanup-firewall
)

uninstall_service() {
  require_root
  local mode="${1:-}" answer
  [[ "$mode" == '' || "$mode" == --purge ]] || { echo 'Использование: firewall-ui uninstall [--purge]' >&2; return 2; }
  if [[ -z "$mode" && "${FIREWALL_UI_NONINTERACTIVE:-0}" != 1 ]]; then
    read -r -p 'Удалить также настройки, данные и сертификаты? [y/N]: ' answer
    [[ "$answer" =~ ^[Yy]$ ]] && mode=--purge
  fi
  local unit
  for unit in firewall-ui-cert-renew.timer firewall-ui-cert-renew.service "${SERVICE}.service"; do
    stop_uninstall_unit "$unit" || return 1
  done
  cleanup_ping_rules || return 1
  if [[ -x "$BIN" ]]; then
    if ! "$BIN" -config "$CONFIG" -cleanup-firewall; then
      echo 'Очистка правил не выполнена. Файлы сохранены; исправьте ошибку и повторите удаление.' >&2
      return 1
    fi
  elif [[ -f "$CONFIG" || -f "$STATE_DIR/state.json" || -f "$UNIT_DIR/${SERVICE}.service" ]]; then
    echo 'Бинарник отсутствует. Загружаем проверенный инструмент очистки без переустановки панели.'
    cleanup_missing_binary || { echo 'Не удалось очистить правила. Файлы сохранены.' >&2; return 1; }
  fi
  if ! cleanup_access_rules; then
    echo 'Не удалось очистить правила доступа. Файлы сохранены для повторной попытки.' >&2
    return 1
  fi
  systemctl disable "${SERVICE}.service" firewall-ui-cert-renew.timer firewall-ui-cert-renew.service >/dev/null 2>&1 || true
  rm -f "$UNIT_DIR/${SERVICE}.service" "$UNIT_DIR/firewall-ui-cert-renew.service" "$UNIT_DIR/firewall-ui-cert-renew.timer" || return 1
  rm -rf -- "$INSTALL_DIR" || return 1
  rm -f -- "$MANAGER_PATH" || return 1
  if [[ "$mode" == --purge ]]; then
    rm -rf -- "$CONFIG_DIR" "$STATE_DIR" || return 1
    echo 'Firewall-UI полностью удалён: панель, настройки, данные, сертификаты и собственные правила.'
  else
    echo "Firewall-UI удалён. Настройки и сертификаты сохранены в $CONFIG_DIR, данные — в $STATE_DIR."
  fi
  systemctl daemon-reload
  systemctl reset-failed "${SERVICE}.service" firewall-ui-cert-renew.service >/dev/null 2>&1 || true
}

menu() (
  require_root
  local installer="$INSTALL_DIR/install.sh" stage
  if [[ -f "$installer" ]]; then bash "$installer" --menu; return; fi
  # Upgrade path for installations created before the unified local menu.
  stage="$(mktemp -d)"; trap 'rm -rf -- "$stage"' EXIT
  curl -fLsS --retry 3 --connect-timeout 15 "https://raw.githubusercontent.com/$REPO/main/install.sh" -o "$stage/install.sh"
  bash "$stage/install.sh" --menu
)

main() {
case "${1:-}" in
  start|stop|restart|reload)
    require_root
    service_action "$1"
    ;;
  status)
    show_status
    ;;
  logs-once)
    journalctl -u "${SERVICE}.service" -n 100 --no-pager
    ;;
  log|logs)
    show_logs
    ;;
  update)
    update_binary
    ;;
  credentials|password)
    change_credentials
    ;;
  reset-password)
    reset_password
    ;;
  rollback)
    rollback_binary
    ;;
  uninstall)
    uninstall_service "${2:-}"
    ;;
  ""|menu)
    menu
    ;;
  *)
    echo "Usage: firewall-ui [start|stop|restart|status|logs|update|rollback|credentials|reset-password|uninstall [--purge]]"
    exit 2
    ;;
esac

}
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then main "$@"; fi
