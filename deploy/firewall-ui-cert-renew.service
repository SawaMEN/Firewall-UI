[Unit]
Description=Renew Firewall-UI TLS certificate
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/firewall-ui/acme/renewal

[Service]
Type=oneshot
ExecStart=/usr/bin/env certbot renew --quiet --config-dir /etc/firewall-ui/acme --work-dir /var/lib/firewall-ui/acme --logs-dir /var/lib/firewall-ui/acme-logs --deploy-hook "/usr/local/bin/fw-ui restart"
UMask=0077
