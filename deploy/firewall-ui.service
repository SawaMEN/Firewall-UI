[Unit]
Description=Firewall-UI standalone web firewall
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
EnvironmentFile=/etc/firewall-ui/environment
ExecStart=/usr/local/bin/firewall-ui -listen 127.0.0.1:8088 -state /var/lib/firewall-ui/state.json
Restart=on-failure
RestartSec=5
StateDirectory=firewall-ui
StateDirectoryMode=0700
UMask=0077

[Install]
WantedBy=multi-user.target
