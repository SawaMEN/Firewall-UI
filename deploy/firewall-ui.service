[Unit]
Description=Firewall-UI standalone web firewall
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
EnvironmentFile=/etc/firewall-ui/environment
ExecStart=/usr/local/firewall-ui/firewall-ui -config /etc/firewall-ui/config.json
Restart=always
RestartSec=3
StateDirectory=firewall-ui
StateDirectoryMode=0700
UMask=0077
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
